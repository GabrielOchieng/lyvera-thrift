// 1. Configuration
generator client {
  provider = "prisma-client-js"
  // Tip: Removing custom output ensures Turbopack and Vercel 
  // can find the generated types automatically.
}

datasource db {
  provider = "postgresql"
 
}

// 2. Models
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text // Use @db.Text for longer descriptions
  price       Int      // Stored in cents (e.g., $10.00 = 1000) to avoid float errors
  size        String
  images      String[]
  
  // Status tracking
  isSold      Boolean  @default(false)
  stock       Int      @default(1)
  
  // Relations
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  // Timestamps (Crucial for audits and "New Arrivals" sorting)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Indexes (Professional touch: makes searching by category or status much faster)
  @@index([categoryId])
  @@index([isSold])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  
  // Customer Details
  customerName    String
  customerPhone   String
  deliveryAddress String
  
  // Payment Details
  mpesaCode       String      @unique
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, VERIFIED, SHIPPED
  
  // Relations
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  
  // Snapshot of item at time of purchase
  productId String
  name      String
  price     Float
  size      String
  image     String
}