generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  uploadId    String?  // <--- ADD THIS (Optional, used for grouping)
  price       Int
  size        String
  images      String[]
  isSold      Boolean     @default(false)
  stock       Int         @default(1)
  categoryId  String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  source      String      @default("TIKTOK")
  videoUrl    String?
  category    Category    @relation(fields: [categoryId], references: [id])
  
  // ✅ ADDED: This allows you to check which OrderItems this product belongs to
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isSold])
  @@index([uploadId]) // Recommended for faster polling lookups
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Order {
  id                String      @id @default(cuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  createdAt         DateTime    @default(now())
  customerName      String
  customerPhone     String
  deliveryAddress   String
  mpesaCode         String      @unique
  checkoutRequestId String?     @unique
  totalAmount       Float
  status            String      @default("PENDING") // PENDING, VERIFIED, CANCELLED
  items             OrderItem[]
  phone String @default("0000000000")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  size      String
  image     String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // ✅ ADDED: This links the OrderItem back to the actual Product record
  product   Product @relation(fields: [productId], references: [id])
}

model UserSession {
  phone       String   @id
  state       String   @default("IDLE")
  userName    String?  // <--- ADD THIS
  location    String?  // <--- ADD THIS
  cartItems   Json?
  lastOrderId String?
  updatedAt   DateTime @updatedAt
}

model ProcessedMessage {
  id        String   @id
  createdAt DateTime @default(now())
}


model ChatSession {
  id        String   @id @default(uuid())
  phone     String   @unique
  state     String   @default("browsing")
  cart      Json     @default("[]")

  name      String?
  phoneInput String?
  location  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatHistory {
  id        String   @id @default(cuid())
  phone     String
  role      String   // "user" or "bot"
  message   String
  createdAt DateTime @default(now())
}