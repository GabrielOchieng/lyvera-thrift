generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int
  size        String
  images      String[]
  isSold      Boolean  @default(false)
  stock       Int      @default(1)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  source      String   @default("TIKTOK")
  videoUrl    String?
  category    Category @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isSold])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Order {
  id              String      @id @default(cuid())
  createdAt       DateTime    @default(now())
  customerName    String
  customerPhone   String
  deliveryAddress String
  mpesaCode       String      @unique
  totalAmount     Float
  status          String      @default("PENDING")
  items           OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Float
  size      String
  image     String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
